# Copy this file to .env. Never commit real credentials.
OAUTH_BASE_URL=http://127.0.0.1:4317

# Meta app: Facebook Login for Business + required Page/Instagram permissions.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=change-this-to-a-long-random-value

# Optional provider applications.
THREADS_APP_ID=
THREADS_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BLOGGER_REDIRECT_URI=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Additional social gateways (register web apps and use the callbacks below)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# https://YOUR-HOST/api/oauth/reddit/callback
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=
# https://YOUR-HOST/api/oauth/tumblr/callback
# Mastodon (mastodon.social) registers its OAuth client per connection attempt.
# Bluesky app passwords are entered in Settings and encrypted in the database.
